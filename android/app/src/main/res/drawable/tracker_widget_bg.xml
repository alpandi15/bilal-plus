<?xml version="1.0" encoding="utf-8"?>
<!-- Latar widget Ibadah Harian, Al-Qur'an & hitung mundur Ramadan: hijau
     tua bergradasi seperti kartu Al-Qur'an di Beranda (#00503C -> #0C3A33),
     cahaya emas lembut di pojok kanan atas, semburat zamrud di kiri bawah,
     dan garis tepi emas tipis. Tanpa ornamen di belakang isi supaya daftar
     tetap bersih & mudah dibaca. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="315"
                android:startColor="#00503C"
                android:centerColor="#03463A"
                android:endColor="#0C3A33" />
        </shape>
    </item>
    <item
        android:gravity="top|end"
        android:width="180dp"
        android:height="180dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="90dp"
                android:startColor="#4DF2D38A"
                android:centerColor="#14F2D38A"
                android:endColor="#00F2D38A" />
        </shape>
    </item>
    <item
        android:gravity="bottom|start"
        android:width="160dp"
        android:height="160dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="80dp"
                android:startColor="#2E34D399"
                android:endColor="#0034D399" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#4DF2D38A" />
        </shape>
    </item>
</layer-list>
