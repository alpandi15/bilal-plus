<?xml version="1.0" encoding="utf-8"?>
<!-- progressDrawable batang tipis membulat: jalur samar + isian emas. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="99dp" />
            <solid android:color="#26E3BE6A" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="99dp" />
                <gradient
                    android:angle="0"
                    android:startColor="#D9A441"
                    android:endColor="#F2D38A" />
            </shape>
        </clip>
    </item>
</layer-list>
