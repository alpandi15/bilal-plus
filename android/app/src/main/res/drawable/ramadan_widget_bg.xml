<?xml version="1.0" encoding="utf-8"?>
<!-- Latar widget hitung mundur Ramadan: zamrud gelap bergradasi, cahaya
     emas lembut di pojok kanan atas, ornamen bintang delapan (rub el hizb)
     samar di kanan bawah, dan garis tepi emas tipis. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="315"
                android:startColor="#0C3A33"
                android:centerColor="#125649"
                android:endColor="#082922" />
        </shape>
    </item>
    <item
        android:gravity="top|end"
        android:width="170dp"
        android:height="170dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="85dp"
                android:startColor="#59E3BE6A"
                android:centerColor="#1AE3BE6A"
                android:endColor="#00E3BE6A" />
        </shape>
    </item>
    <item
        android:gravity="bottom|start"
        android:width="150dp"
        android:height="150dp">
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="75dp"
                android:startColor="#3334D399"
                android:endColor="#0034D399" />
        </shape>
    </item>
    <item
        android:gravity="bottom|end"
        android:width="118dp"
        android:height="118dp"
        android:right="4dp"
        android:bottom="2dp"
        android:drawable="@drawable/ramadan_ornament_star" />
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#40E3BE6A" />
        </shape>
    </item>
</layer-list>
