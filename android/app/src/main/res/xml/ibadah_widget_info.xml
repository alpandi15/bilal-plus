<?xml version="1.0" encoding="utf-8"?>
<!-- 2x3 sel (2 kolom x 3 baris; 110x180dp untuk Android 11 ke bawah,
     targetCell* untuk Android 12+), bisa diregangkan sampai 2x4 atau lebih
     lebar - isinya bertambah mengikuti tinggi (lihat provider-nya).

     previewImage statis (render widget asli berisi data contoh), BUKAN
     previewLayout - sebagian launcher menganggap previewLayout tidak sah
     lalu menampilkan kosong atau menyembunyikan widgetnya (lihat catatan di
     prayer_widget_info.xml). Buat ulang PNG-nya bila tampilan widget berubah
     (WidgetPreviewActivity, build debug).

     updatePeriodMillis 30 menit: pergantian hari paling telat terlihat 30
     menit sesudah tengah malam - datanya sudah memuat hari esok. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="180dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="180dp"
    android:targetCellWidth="2"
    android:targetCellHeight="3"
    android:maxResizeHeight="420dp"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/ibadah_widget_layout"
    android:previewImage="@drawable/widget_preview_ibadah"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/ibadah_widget_description">
</appwidget-provider>
