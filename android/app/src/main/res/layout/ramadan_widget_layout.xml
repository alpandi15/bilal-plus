<?xml version="1.0" encoding="utf-8"?>
<!-- Widget hitung mundur Ramadan (2x2, bisa 2x3/3x2): satu tema dengan widget
     Ibadah Harian & Al-Qur'an (hijau tua & emas, seperti kartu Al-Qur'an). Hanya jumlah hari -
     tanpa jam berjalan - dengan narasi pendek. Semua teksnya diisi
     RamadanWidgetProvider.kt; latarnya drawable statis (ringan, tanpa
     bitmap). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ramadan_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tracker_widget_bg">

    <!-- bulan sabit besar samar sebagai aksen di kanan atas -->
    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-14dp"
        android:layout_marginEnd="-14dp"
        android:src="@drawable/widget_ic_crescent"
        android:tint="#F2D38A"
        android:alpha="0.14"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:id="@+id/ramadan_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <!-- kepala -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/widget_ic_crescent"
                android:tint="#F2D38A"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/ramadan_kicker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="@string/ramadan_kicker_default"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textColor="#F2D38A" />
        </LinearLayout>

        <!-- pengisi ruang (FrameLayout kosong; <Space> bukan @RemoteView) -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- angka besar + pil satuan (rata bawah, bukan baselineAligned:
             penggeseran baseline memotong kotak label) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:gravity="bottom">

            <TextView
                android:id="@+id/ramadan_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="46sp"
                android:textStyle="bold"
                android:letterSpacing="-0.03"
                android:includeFontPadding="false"
                android:fontFeatureSettings="tnum"
                android:textColor="#F6DFA4" />

            <!-- satuan ditumpuk dua baris di samping angka ("HARI / LAGI") -->
            <TextView
                android:id="@+id/ramadan_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="6dp"
                android:text="@string/ramadan_unit_default"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:textColor="#F2D38A" />
        </LinearLayout>

        <!-- judul -->
        <TextView
            android:id="@+id/ramadan_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textColor="#F4F1EA" />

        <!-- tanggal dalam pil kaca -->
        <TextView
            android:id="@+id/ramadan_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/tracker_glass_pill"
            android:textSize="9.5sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textColor="#D3E5DF" />

        <!-- narasi -->
        <TextView
            android:id="@+id/ramadan_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="9.5sp"
            android:textStyle="italic"
            android:lineSpacingExtra="1.5dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:textColor="#B9D3CB" />
    </LinearLayout>
</FrameLayout>
