<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Hafalan" (3x2 / 4x2, bisa ditinggikan): ayat berikutnya yang
     belum hafal, digambar besar dengan font mushaf (bitmap dari
     HafalanWidgetProvider.kt), terjemahan bila muat, lalu tombol
     "Tutup/Lihat" (uji hafalan) & "Hafal" (maju ke ayat berikutnya). -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tracker_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <!-- kepala: surah + x/y -->
        <LinearLayout
            android:id="@+id/hw_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/tracker_ic_book"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/hw_kicker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HAFALAN"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textColor="#F2D38A" />

            <TextView
                android:id="@+id/hw_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/tracker_unit_pill"
                android:text="0/0"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:textColor="#F2D38A" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/hw_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="7dp"
            android:max="1000"
            android:progress="0"
            android:progressDrawable="@drawable/tracker_bar" />

        <!-- ayat: bitmap font mushaf (ketuk = buka aplikasi) -->
        <FrameLayout
            android:id="@+id/hw_ayah_box"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:background="@drawable/hafalan_ayah_bg"
            android:padding="6dp">

            <ImageView
                android:id="@+id/hw_ayah"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Ayat" />

            <TextView
                android:id="@+id/hw_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Tandai ayat yang sudah hafal di aplikasi - ayat berikutnya muncul di sini."
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="2dp"
                android:textColor="#F4F1EA"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/hw_translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text=""
            android:textSize="10.5sp"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:ellipsize="end"
            android:textColor="#B9D3CB" />

        <!-- kaki: posisi + tombol -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/hw_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Ayat 1"
                android:textSize="10.5sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textColor="#B9D3CB" />

            <TextView
                android:id="@+id/hw_peek"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/tracker_glass_pill"
                android:text="Tutup"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#F4F1EA" />

            <TextView
                android:id="@+id/hw_done"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/tracker_pill"
                android:text="✓ Hafal"
                android:textSize="11sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:textColor="#0C3A33" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
