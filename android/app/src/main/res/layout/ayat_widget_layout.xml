<?xml version="1.0" encoding="utf-8"?>
<!-- Widget "Ayat Harian" (3x2 / 4x2): satu ayat per hari, digambar besar
     dengan font mushaf pilihan pengguna (bitmap dari AyatWidgetProvider.kt),
     terjemahan bila muat. Ketuk = buka ayatnya di pembaca. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/aw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tracker_widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/tracker_ic_book"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/aw_kicker"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="AYAT HARI INI"
                android:textSize="9.5sp"
                android:textStyle="bold"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false"
                android:textColor="#F2D38A" />

            <TextView
                android:id="@+id/aw_ref"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:background="@drawable/tracker_unit_pill"
                android:text="2:152"
                android:maxLines="1"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:textColor="#F2D38A" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/aw_ayah_box"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:background="@drawable/hafalan_ayah_bg"
            android:padding="6dp">

            <ImageView
                android:id="@+id/aw_ayah"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:contentDescription="Ayat hari ini" />

            <TextView
                android:id="@+id/aw_empty"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:text="Buka Bilal+ sekali untuk memuat ayat hari ini."
                android:textSize="12.5sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="#F4F1EA"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/aw_translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="10.5sp"
            android:lineSpacingExtra="1dp"
            android:maxLines="3"
            android:ellipsize="end"
            android:textColor="#B9D3CB" />
    </LinearLayout>
</FrameLayout>
